{
  "name": "agrovinc-servidor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Servidor do app AGROVINC: cadastro, código de acesso, assinatura e mensagens (WhatsApp, SMS, e-mail).",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrar": "node src/migrar.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1"
  }
}
