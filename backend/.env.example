# Copie este arquivo para ".env" e preencha.

# Banco de dados PostgreSQL
DATABASE_URL=postgres://agrovinc:agrovinc@localhost:5432/agrovinc
PORTA=3333

# Endereço do site (usado nos links de pagamento enviados no WhatsApp)
URL_SITE=https://agrovinc.com.br

# Segredo do servidor: troque por uma frase longa e aleatória antes de ir para produção
SEGREDO_SERVIDOR=troque-este-segredo-em-producao

# MODO_TESTE=true mostra o código na resposta da API e permite simular pagamentos/compras.
# EM PRODUÇÃO: MODO_TESTE=false e NODE_ENV=production
MODO_TESTE=true
NODE_ENV=development

# Código de acesso
CODIGO_DIGITOS=6
CODIGO_VALIDADE_MIN=10
CODIGO_TENTATIVAS=5
CODIGO_ESPERA_SEG=60

# --- API oficial do WhatsApp (Meta Cloud API) ---
# Sem token, o servidor roda em "modo simulação" (mensagens aparecem no terminal).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=uma-frase-que-voce-inventar
WHATSAPP_IDIOMA=pt_BR

# --- E-mail (SMTP). Sem host, roda em modo simulação ---
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=AGROVINC <nao-responda@agrovinc.com.br>

# --- SMS (reserva do código de acesso). Vazio = modo simulação ---
# SMS_PROVEDOR=zenvia  ou  SMS_PROVEDOR=twilio
SMS_PROVEDOR=
# Zenvia: painel da Zenvia → Integrações → Tokens. Remetente = nome cadastrado na Zenvia.
ZENVIA_TOKEN=
ZENVIA_REMETENTE=
# Twilio: Account SID e Auth Token do painel da Twilio, e o número (+1...) ou o Messaging Service SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMERO=
TWILIO_MESSAGING_SERVICE_SID=

# --- Pagamento pelo site (Pix e cartão) ---
# Com PAGAMENTO_PROVEDOR=asaas e a chave, cobra de verdade. Vazio = simulação (só com MODO_TESTE=true).
PAGAMENTO_PROVEDOR=
# Asaas: Minha conta → Integrações → Chave de API.
ASAAS_API_KEY=
# Produção: https://api.asaas.com/v3   Testes (sandbox): https://api-sandbox.asaas.com/v3
ASAAS_URL=https://api.asaas.com/v3
# Invente uma frase e use a mesma no Asaas: Integrações → Webhooks → endereço https://SEU_DOMINIO/pagamentos/asaas
ASAAS_WEBHOOK_TOKEN=
# Formato neutro (outra empresa ou integração própria): cabeçalho X-Webhook-Secret em /pagamentos/webhook
PAGAMENTO_WEBHOOK_SEGREDO=
LINK_PAGAMENTO_DIAS=7
VALOR_CENTAVOS=2990

# --- Assinatura pela loja ---
LOJA_PRODUTO_ID=agrovinc_assinatura_mensal
# Google Play: caminho do arquivo .json da conta de serviço (ou o conteúdo do json numa linha só)
GOOGLE_PLAY_PACOTE=br.com.agrovinc.app
GOOGLE_CONTA_SERVICO=
# Invente uma frase; o endereço do Pub/Sub fica https://SEU_DOMINIO/webhooks/google-play?segredo=ESSA_FRASE
GOOGLE_PLAY_WEBHOOK_SEGREDO=
# App Store Connect → Usuários e acesso → Integrações → Compras no app: Issuer ID, Key ID e o arquivo .p8
APPLE_BUNDLE_ID=br.com.agrovinc.app
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_CHAVE_P8=
# producao (padrão) ou sandbox. O servidor tenta os dois: compras do TestFlight e da revisão da Apple são de teste.
APPLE_AMBIENTE=producao

# --- Fotos dos anúncios: vazio = no disco do servidor. Para nuvem (Cloudflare R2 ou Amazon S3): ---
FOTOS_S3_BUCKET=
FOTOS_S3_ENDPOINT=
FOTOS_S3_REGIAO=auto
FOTOS_S3_CHAVE=
FOTOS_S3_SEGREDO=
# Endereço público das fotos (ex.: https://fotos.agrovinc.com.br)
FOTOS_URL_PUBLICA=

# --- Moderação ---
# Chave da equipe para o painel (/painel) e as rotas /admin: frase longa, pelo menos 20 caracteres.
# Sem ela, o painel não entra.
ADMIN_TOKEN=
# E-mail que recebe aviso de cada denúncia
EMAIL_MODERACAO=
